NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional, server only: lets admins email login invites from Settings. Never share or commit the real value.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional, server only: Square Production access token, so the supplement list comes from Square. Never share or commit it.
SQUARE_ACCESS_TOKEN=
# Optional: the Square reporting category to read (default Product).
# SQUARE_CATEGORY=Product
